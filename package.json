{
  "name": "cipher-mux-electron",
  "version": "0.12.8",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "Electron-basierte Kommandozentrale fuer Coding-CLIs (Claude Code, Codex, opencode)",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "BUILD_PROFILE=cipher concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "version:generate": "echo \"// src/shared/version.ts — Auto-generated by scripts/git-version.sh\\n// Do not edit manually.\\nexport const APP_VERSION = '$(./scripts/git-version.sh)';\" > src/shared/version.ts",
    "clean": "rm -rf dist/main dist/renderer out/mac-arm64 node_modules/.vite",
    "build": "npm run clean && npm run version:generate && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && cp src/main/voice/piper-worker.js dist/main/main/voice/",
    "build:renderer": "vite build",
    "predist": "bash scripts/copy-voice-model.sh",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "start": "BUILD_PROFILE=cipher electron .",
    "prestart": "electron-builder install-app-deps 2>/dev/null || true",
    "test": "npm run rebuild:node && node --test --import tsx $(find test -name '*.test.ts' | sort)",
    "gen:companion-ref": "node scripts/gen-companion-mcp-ref.mjs",
    "rebuild:node": "cd node_modules/better-sqlite3 && npx node-gyp rebuild --release 2>/dev/null",
    "rebuild:electron": "npx electron-rebuild -f -w better-sqlite3",
    "rebuild:voice": "npx electron-rebuild -f -w @fugood/whisper.node sherpa-onnx-node 2>/dev/null; echo 'Voice native modules rebuilt for Electron ABI'",
    "build:community": "BUILD_PROFILE=community npm run build",
    "build:cipher": "BUILD_PROFILE=cipher npm run build",
    "profile-lint": "tsx scripts/profile-lint.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "postinstall": "electron-builder install-app-deps && npm run rebuild:voice"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
    "i18next": "^26.0.8",
    "lucide-preact": "^1.14.0",
    "react-i18next": "^17.0.4",
    "ulidx": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.2",
    "@types/better-sqlite3": "^7.6.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "preact": "^10.24.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.0.0"
  },
  "author": "cipher",
  "license": "MIT",
  "optionalDependencies": {
    "@fugood/whisper.node": "^1.0.18",
    "sherpa-onnx-node": "^1.12.38"
  }
}
